# Gold & Diamond Browser — profile-scoped bookmark collection
# The collection and its persistence rules are owned by Memingo.

vibe request = json_parse(env("GDB_REQUEST", "{}"))
vibe profile_id = request.profile_id
when profile_id == "" {
    profile_id = "default"
}
vibe storage_path = "data/bookmarks-" + profile_id + ".json"
when profile_id == "default" {
    storage_path = "data/bookmarks.json"
}
vibe bookmarks = []

when file_exists(storage_path) {
    bookmarks = json_parse(read_file(storage_path))
}

when request.action == "add" {
    when request.url != "" {
        push(bookmarks, {
            url: request.url,
            title: request.title,
            created_at: now()
        })
        write_file(storage_path, json_stringify(bookmarks))
    }
}

ritual keep_bookmark(item) {
    drop item.url != request.url
}

when request.action == "remove" {
    bookmarks = filter(bookmarks, keep_bookmark)
    write_file(storage_path, json_stringify(bookmarks))
}

when request.action == "clear" {
    bookmarks = []
    write_file(storage_path, json_stringify(bookmarks))
}

spill json_stringify({bookmarks: bookmarks, profile_id: profile_id})
