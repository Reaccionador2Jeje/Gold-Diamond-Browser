# Gold & Diamond Browser — profile-scoped saved browsing sessions
# Memingo owns session persistence. Private tabs are filtered by the Qt host.

vibe request = json_parse(env("GDB_REQUEST", "{}"))
vibe profile_id = request.profile_id
when profile_id == "" {
    profile_id = "default"
}
vibe storage_path = "data/session-" + profile_id + ".json"
when profile_id == "default" {
    storage_path = "data/session.json"
}
vibe tabs = []

when file_exists(storage_path) {
    tabs = json_parse(read_file(storage_path))
}

when request.action == "save" {
    tabs = request.tabs
    write_file(storage_path, json_stringify(tabs))
}

spill json_stringify({tabs: tabs, profile_id: profile_id})
