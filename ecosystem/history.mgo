# Gold & Diamond Browser — profile-scoped browsing history
# History records are stored and managed by Memingo.

vibe request = json_parse(env("GDB_REQUEST", "{}"))
vibe profile_id = request.profile_id
when profile_id == "" {
    profile_id = "default"
}
vibe storage_path = "data/history-" + profile_id + ".json"
vibe legacy_path = "data/history.json"
vibe entries = []

when file_exists(storage_path) {
    entries = json_parse(read_file(storage_path))
} else {
    when profile_id == "default" && file_exists(legacy_path) {
        entries = json_parse(read_file(legacy_path))
    }
}

when request.action == "add" {
    when request.url != "" {
        push(entries, {
            url: request.url,
            title: request.title,
            visited_at: now()
        })
        write_file(storage_path, json_stringify(entries))
    }
}

when request.action == "clear" {
    entries = []
    write_file(storage_path, json_stringify(entries))
}

spill json_stringify({history: entries, profile_id: profile_id})
